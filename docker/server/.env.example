# Copy to `.env` and fill in. Compose reads this file both for variable
# substitution and as the container environment (see docker-compose.yml).

# The public hostname the tunnel serves — NO scheme, NO port, NO trailing slash.
# It must match the Cloudflare Tunnel public hostname exactly, because it is the
# core's whole host allowlist.
PARTNER_HOST=partner.example.com

# Cloudflare Tunnel token:
#   Cloudflare dashboard → Networks → Tunnels → your tunnel → Install/Configure
# Keep this file out of version control (docker/server/.gitignore covers it).
TUNNEL_TOKEN=

# --- accounts (M22) --------------------------------------------------------

# `login` (default for this image) authenticates a USER with a passphrase and
# closes the pairing ceremony; `pairing` is the desktop ceremony, for a core on
# a machine you can physically reach.
AUTH_MODE=login

# Optional: the client class a login session is minted with (desktop | mobile |
# extension). `desktop` is the owner of their own instance; set `mobile` to
# keep file write / roots / deploy / skill install out of reach even for a
# signed-in session.
# LOGIN_SESSION_CLASS=desktop

# Optional per-peer budget for the sign-in route (default 10 per 60s). This sits
# ON TOP of the per-credential lockout (3 failures → 5 minutes).
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_MS=60000

# --- files (M22) -----------------------------------------------------------

# The ONLY directories the file tools can see, comma-separated, absolute. The
# deployment owns them: the core registers them at boot and `/v1/roots` refuses
# to add or remove one. Default is the mounted volume below; mount a real host
# directory there in docker-compose.yml if you want your own files.
FIXED_ROOTS=/files

# --- optional --------------------------------------------------------------

# Scheduling (M14). The default tick is every 30s; set a timezone so daily
# schedules fire when you expect rather than in UTC.
# SCHEDULER_TICK_MS=30000
# SCHEDULER_TZ=Europe/Berlin

# Session lifetime for signed-in browsers (default 30 days).
# SESSION_TTL_MS=2592000000

# --- multi-user partitions (R1) --------------------------------------------

# Each account gets its OWN encrypted database, key and skills directory, so a
# second user is a normal thing to create:
#   docker compose exec partner node tools/user.mjs add <name>
# These bound the open handles (each is a database plus ~40 stores).
# PARTITION_MAX_OPEN=8

# Close a partition after this many milliseconds idle (0 = never). Closing drops
# its key material from memory; the next request re-opens it. Note this is memory
# hygiene, not cryptographic re-locking: the key lives on the volume.
# PARTITION_IDLE_MS=0

# --- refusing writes, capping uploads (R6/R7) ------------------------------

# Register the deployment's roots read-only (the file tools then refuse edits).
# FIXED_ROOTS_READ_ONLY=1

# Per-attachment cap (default 8 MiB) and JSON body cap (default 1 MiB).
# MAX_UPLOAD_BYTES=8388608
# MAX_JSON_BYTES=1048576

# --- real client IPs behind the tunnel (R4) --------------------------------

# cloudflared is the only ingress, so every request arrives from its container
# address: without this, ALL clients share one rate-limit bucket. With it, the
# header is believed ONLY from a trusted network, and only for rate limiting —
# never to decide whether a request is "local".
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
