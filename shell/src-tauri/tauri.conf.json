{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Partner",
  "version": "0.0.0",
  "identifier": "dev.ne1.partner",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:4390",
    "beforeBuildCommand": "",
    "frontendDist": "./static-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Partner",
        "url": "http://127.0.0.1:4390",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi",
      "dmg"
    ],
    "externalBin": [
      "binaries/partner-core"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {}
}
